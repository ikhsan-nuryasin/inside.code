# ============================================
# Inside Code - Git Ignore
# ============================================

# Environment files / secrets
# Root and private env files stay ignored.
.env
.env.*
!.env.example
!.env.*.example
# This project intentionally tracks web/.env because it contains only VITE_* browser-public values.
!web/.env

# Local env files/folders without dot
env
env/
**/env
**/env/

# Node / npm / pnpm / yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Vite / build output
dist/
build/
.vite/
.cache/

# Wrangler / Cloudflare local files
.wrangler/
.dev.vars
.dev.vars.*

# Test / coverage
coverage/
.nyc_output/

# Supabase local development
.supabase/
supabase/.branches/
supabase/.temp/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*.swn

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary / backup files
*.tmp
*.temp
*.bak
*.backup

# Local databases
*.sqlite
*.sqlite3
*.db

# Uploads / generated local files
uploads/
storage/
user-uploads/
generated/

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx

# Local config / credentials
credentials/
secrets/
*.secret
*.credentials

# Local tooling / cache
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/

# Python cache
__pycache__/
*.py[cod]

# Windows local files
*.lnk

# Generated TypeScript build info
*.tsbuildinfo

# IMPORTANT
# Never commit private secrets. The only env file intentionally tracked here is web/.env,
# and it must contain browser-public VITE_* values only.
# Never put these secrets in the repository:
# - Supabase service_role or sb_secret keys
# - Turnstile secret key
# - VAPID private key
# - webhook secrets
# - database passwords
