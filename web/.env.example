# true = UI/demo works without Supabase
# false = use the real Supabase project
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser Web Push (public key only; never put the private VAPID key here)
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# Cloudflare Turnstile (public site key only; configure secret key in Supabase Auth Bot Protection)
VITE_CAPTCHA_REQUIRED=true
VITE_TURNSTILE_SITE_KEY=
